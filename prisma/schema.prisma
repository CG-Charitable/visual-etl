generator client {
  provider = "prisma-client-js"
  output   = "../tools/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminOrgAssignment {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  userId         String
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id])
  User           User         @relation(fields: [userId], references: [id])
}

model Beneficiaries {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  programId      String
  Gender         String?
  Age            String?
  Count          Int?
  Organization   Organization @relation(fields: [organizationId], references: [id])
  Program        Program      @relation(fields: [programId], references: [id])
}

model BeneficiaryAgeName {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  dataRequestId  String
  AgeKey         String
  AgeName        String?
  DataRequest    DataRequest  @relation(fields: [dataRequestId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model BeneficiaryUnique {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  dataRequestId  String
  Gender         String?
  Age            String?
  Count          Int?
  DataRequest    DataRequest  @relation(fields: [dataRequestId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model CountryCodes {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime
  country   String   @unique
  code      String
  type      String
}

model CountryOfOperation {
  id             String          @id
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  organizationId String
  Name           String?
  dataRequestId  String
  ServiceArea    String?
  DataRequest    DataRequest     @relation(fields: [dataRequestId], references: [id])
  Organization   Organization    @relation(fields: [organizationId], references: [id])
  EntityCountry  EntityCountry[]
  OrgCountryMap  OrgCountryMap[]
}

model DataRequest {
  id                     String                  @id
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  status                 String
  year                   Int
  googleSheetId          String?
  googleSheetSensitiveId String?
  organizationId         String
  ContactName            String?
  ContactTitle           String?
  ContactPhone           String?
  ContactPhoneType       String?
  ContactEmail           String?
  CheckAddr              String?
  CheckAddrChange        Boolean?
  LegalEntitiesNo        Int?
  CountriesNo            Int?
  GenMission             String?
  GenMissionChangeYN     Boolean?
  GenMissionChanges      String?
  GenAnnualReport        DateTime?
  GenHandbook            String?
  GenOverallComments     String?
  GenVignette            String?
  GenCharacter           String?
  GenProgramNum          Int?
  VulMatrixConf          String?
  ExplainFundRatio       String?
  ExplainCashOnHand      String?
  ExplainSupportRatio    String?
  ExplainPL              String?
  approved               String?
  currentOrNew           String                  @default("Current")
  isEditable             Boolean                 @default(false)
  CorrEx                 String?
  CorrYN                 Boolean?
  FutProgCom             String?
  progressSnapshot       Json?
  importedAt             DateTime?
  BeneficiaryAgeName     BeneficiaryAgeName[]
  BeneficiaryUnique      BeneficiaryUnique[]
  CountryOfOperation     CountryOfOperation[]
  Organization           Organization            @relation(fields: [organizationId], references: [id])
  Donor                  Donor[]
  Employee               Employee[]
  Entity                 Entity[]
  EntityCountry          EntityCountry[]
  FormComment            FormComment[]
  FutureEstimate         FutureEstimate[]
  FutureEstimateComment  FutureEstimateComment[]
  FutureEstimatePay      FutureEstimatePay[]
  FutureEstimateProgram  FutureEstimateProgram[]
  ImportIssue            ImportIssue[]
  Partner                Partner[]
  Program                Program[]
  Volunteer              Volunteer[]
  Vulnerabilities        Vulnerabilities[]
  VulnerabilityFactor    VulnerabilityFactor[]
}

model Donor {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  dataRequestId  String
  Name           String
  Country        String?
  Email          String?
  DataRequest    DataRequest  @relation(fields: [dataRequestId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model Employee {
  id              String           @id
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  organizationId  String
  dataRequestId   String
  entityCountryId String?
  EmpName         String?
  EmpTitle        String?
  EmpCountry      String?
  EmpSalaryGross  Decimal?
  EmpBen          Decimal?
  EmpMonthsWkd    Int?
  EmpWorkPct      Decimal?
  EmpTopPay       Boolean?
  EmpBottomPay    Boolean?
  EmpCGCat        String?
  EmpCity         String?
  EmpWitholdings  Decimal?
  DataRequest     DataRequest      @relation(fields: [dataRequestId], references: [id])
  EntityCountry   EntityCountry?   @relation(fields: [entityCountryId], references: [id])
  Organization    Organization     @relation(fields: [organizationId], references: [id])
  OrgEmployeeMap  OrgEmployeeMap[]
}

model Entity {
  id                           String            @id
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime
  dataRequestId                String
  organizationId               String
  Name                         String?
  TaxId                        String?
  FoundYear                    Int?
  Url                          String?
  TopAdminName                 String?
  TopAdminTitle                String?
  Country                      String?
  EntityType                   String?
  TaxFilingReq                 Boolean?
  OfficeAddr                   String?
  IndieLedger                  Boolean?
  ConsolEntity                 String?
  TopFinName                   String?
  TopFinTitle                  String?
  FiscalYearEnd                DateTime?
  FinancialsPreparer           String?
  InsideOrOut                  String?
  FinConflictOfIntrest         String?
  AccountingStandards          String?
  StatementCurrency            String?
  FxRate                       Decimal?
  FinStatementLanguage         String?
  LevelOfReview                String?
  CpaFirm                      String?
  DateFinFinal                 DateTime?
  DateFinSent                  DateTime?
  FinancialFile                String?
  DateIncorpReceived           DateTime?
  DateBylawsReceived           DateTime?
  TotAssetsLoc                 Decimal?
  TotLiabLoc                   Decimal?
  TotRevLoc                    Decimal?
  TotExpenseLoc                Decimal?
  TotTranInLoc                 Decimal?
  TotTranOutLoc                Decimal?
  TotAssetsUSD                 Decimal?
  TotLiabUSD                   Decimal?
  TotRevUSD                    Decimal?
  TotExpenseUSD                Decimal?
  TotTranInUSD                 Decimal?
  TotTranOutUSD                Decimal?
  AccountingBasis              String?
  ExpenseRestrictedLoc         Decimal?
  NetAssetsWithRestrictionsLoc Decimal?
  TotFundraisingExpLoc         Decimal?
  DataRequest                  DataRequest       @relation(fields: [dataRequestId], references: [id])
  Organization                 Organization      @relation(fields: [organizationId], references: [id])
  EntityCountry                EntityCountry[]
  OrgEntityMap                 OrgEntityMap[]
  ProgramByEntity              ProgramByEntity[]
}

model EntityCountry {
  id                           String              @id
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime
  organizationId               String
  dataRequestId                String
  entityId                     String?
  EntityCountry                String
  countryOfOperationId         String?
  isConsolidation              Boolean             @default(false)
  CGcat                        Boolean?
  PropertiesOwned              Int?
  DonatedSpaces                Int?
  HCFracFund                   Decimal?
  HCFracFin                    Decimal?
  HCFracIT                     Decimal?
  HCFracManage                 Decimal?
  HCFracOtherAdmin             Decimal?
  HCFracDirProg                Decimal?
  HCTypeFT                     Int?
  HCTypePT                     Int?
  HCTypeVol                    Int?
  HCCatBoard                   Int?
  HCCatBoardCitizens           Int?
  HCCatExecEmp                 Int?
  HCCatExecVol                 Int?
  HCCatOfficeEmp               Int?
  HCCatOfficeVol               Int?
  HCCatProgEmp                 Int?
  HCCatProgVol                 Int?
  HCCatOtherEmp                Int?
  HCCatOtherVol                Int?
  HCAlumEmp                    Int?
  HCAlumVol                    Int?
  BalTCashAndEquiv             Decimal?
  BalTLBE                      Decimal?
  BalTOtherAssets              Decimal?
  BalRPermRestrict             Decimal?
  BalRGenFunds                 Decimal?
  BalROtherFin                 Decimal?
  BalROtherAssets              Decimal?
  BalLShortLiab                Decimal?
  BalLLongLiab                 Decimal?
  ExplainNonFinAsset           String?
  ExplainLiab                  String?
  TransIn                      Decimal?
  TransOut                     Decimal?
  Rev1InKind                   Decimal?
  Rev1Cash                     Decimal?
  Rev1AllOther                 Decimal?
  Rev2OtherCountry             Decimal?
  Rev2DomGov                   Decimal?
  Rev2Internal                 Decimal?
  Rev2PrivOrg                  Decimal?
  Rev2Ind                      Decimal?
  Rev3PermRestrict             Decimal?
  Rev3TempRestrict             Decimal?
  Rev3UnrestrictGift           Decimal?
  Rev3UnrestrictOther          Decimal?
  Rev4Sponsorship              Decimal?
  Rev4Fundraising              Decimal?
  Rev4Advertising              Decimal?
  Rev4MajorGifts               Decimal?
  Rev4TravelProg               Decimal?
  Rev4Beneficiaries            Decimal?
  Rev4ProgBusiness             Decimal?
  Rev4Endowment                Decimal?
  Rev4Investments              Decimal?
  Rev4AllOther                 Decimal?
  RevExplainInKind             String?
  RevExplainOtherCntry         String?
  RevExplainGov                String?
  RevExplainAllOther           String?
  ExpCompFundraise             Decimal?
  ExpCompFin                   Decimal?
  ExpCompIT                    Decimal?
  ExpCompManagement            Decimal?
  ExpCompOthAdmin              Decimal?
  ExpCompDirProg               Decimal?
  ExpFundSponsorship           Decimal?
  ExpFundVolTravel             Decimal?
  ExpFundEvents                Decimal?
  ExpFundExtComm               Decimal?
  ExpFundOth                   Decimal?
  ExpFinAccting                Decimal?
  ExpFinBanking                Decimal?
  ExpFinInvFees                Decimal?
  ExpFinTaxOnRev               Decimal?
  ExpFinOth                    Decimal?
  ExpITEquipAndMaint           Decimal?
  ExpITSoftware                Decimal?
  ExpITOth                     Decimal?
  ExpOtherAdminBldOcc          Decimal?
  ExpOtherAdminLegalHROth      Decimal?
  ExpOtherAdminNonProgTravMeet Decimal?
  ExpOtherAdminNonProgBiz      Decimal?
  ExpOtherAdminMisc            Decimal?
  ExpProgOccupancy             Decimal?
  ExpProgDesignAndCurric       Decimal?
  ExpProgMandE                 Decimal?
  ExpProgCOGS                  Decimal?
  ExpProgOPEX                  Decimal?
  ExpProgPassThrough           Decimal?
  ExpProgDirProg               Decimal?
  ExpExplainUSProg             String?
  ExpExplainPassThrough        String?
  ExpExplainProgBiz            String?
  ExpProgIT                    Decimal?
  BalRTempCurrent              Decimal?
  BalRTempLong                 Decimal?
  BalTInvAndOtherFin           Decimal?
  ExpExplainProgOther          String?
  ExpRGeneral                  Decimal?
  ExpRPerm                     Decimal?
  ExpRTemp                     Decimal?
  ExplainPermRestrict          String?
  ExplainTempRestrict          String?
  Rev2InvOtherInternal         Decimal?
  Rev2Programs                 Decimal?
  Rev4OtherGifts               Decimal?
  EntityCountryExpensePercent  Decimal?
  Employee                     Employee[]
  CountryOfOperation           CountryOfOperation? @relation(fields: [countryOfOperationId], references: [id])
  DataRequest                  DataRequest         @relation(fields: [dataRequestId], references: [id])
  Entity                       Entity?             @relation(fields: [entityId], references: [id])
  Organization                 Organization        @relation(fields: [organizationId], references: [id])
  Property                     Property[]
  Reconcilliation              Reconcilliation[]
}

model FormComment {
  id            String      @id
  createdAt     DateTime    @default(now())
  dataRequestId String
  tabId         Int
  fieldKey      String?
  text          String
  authorName    String
  authorEmail   String
  DataRequest   DataRequest @relation(fields: [dataRequestId], references: [id], onDelete: Cascade)
}

model FutureEstimate {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  dataRequestId  String
  Year           Int
  Type           String
  PropOwnLease   Int?
  PropDonated    Int?
  FracDirProg    Decimal?
  FracOther      Decimal?
  AssetGenFunds  Decimal?
  AssetFinOther  Decimal?
  AssetAllOther  Decimal?
  LiabShort      Decimal?
  LiabLong       Decimal?
  RevInKind      Decimal?
  RevProg        Decimal?
  RevAllOther    Decimal?
  ExpDirProg     Decimal?
  ExpFund        Decimal?
  ExpAllOth      Decimal?
  DataRequest    DataRequest  @relation(fields: [dataRequestId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model FutureEstimateComment {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  dataRequestId  String
  Type           String
  PropComments   String?
  FracComments   String?
  AssetComments  String?
  LiabComments   String?
  RevComments    String?
  ExpComments    String?
  DataRequest    DataRequest  @relation(fields: [dataRequestId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model FutureEstimatePay {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  dataRequestId  String
  CYHiPayName    String?
  CYHiPayGross   Decimal?
  DataRequest    DataRequest  @relation(fields: [dataRequestId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model FutureEstimateProgram {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  dataRequestId  String
  Year           Int
  programId      String?
  isNewProgram   Boolean?     @default(false)
  newProgramName String?
  DirExp         Decimal?
  CDU            Int?
  DataRequest    DataRequest  @relation(fields: [dataRequestId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
  Program        Program?     @relation(fields: [programId], references: [id])
}

model ImportIssue {
  id             String       @id
  createdAt      DateTime     @default(now())
  dataRequestId  String
  organizationId String
  step           String
  message        String
  DataRequest    DataRequest  @relation(fields: [dataRequestId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model ImportProgress {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  year           Int
  organizationId String
  progress       Int
  status         String
  error          String?
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model OrgCountries {
  id             String          @id
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  organizationId String
  code           String?
  name           String
  aliases        String[]        @default([])
  Organization   Organization    @relation(fields: [organizationId], references: [id])
  OrgCountryMap  OrgCountryMap[]
}

model OrgCountryMap {
  id                      String                   @id
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime
  organizationId          String
  orgCountryId            String
  isHistorical            Boolean                  @default(false)
  countryOfOperationId    String?
  historicalServiceAreaId String?
  year                    Int
  CountryOfOperation      CountryOfOperation?      @relation(fields: [countryOfOperationId], references: [id])
  historical_service_area historical_service_area? @relation(fields: [historicalServiceAreaId], references: [id])
  OrgCountries            OrgCountries             @relation(fields: [orgCountryId], references: [id])
  Organization            Organization             @relation(fields: [organizationId], references: [id])
}

model OrgEmployeeMap {
  id                            String                         @id
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime
  organizationId                String
  orgEmployeeId                 String
  isHistorical                  Boolean                        @default(false)
  employeeId                    String?
  historicalPeopleId            String?
  year                          Int
  Employee                      Employee?                      @relation(fields: [employeeId], references: [id])
  historical_people_and_partner historical_people_and_partner? @relation(fields: [historicalPeopleId], references: [id])
  OrgEmployees                  OrgEmployees                   @relation(fields: [orgEmployeeId], references: [id])
  Organization                  Organization                   @relation(fields: [organizationId], references: [id])
}

model OrgEmployees {
  id             String           @id
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  organizationId String
  code           String?
  name           String
  aliases        String[]         @default([])
  OrgEmployeeMap OrgEmployeeMap[]
  Organization   Organization     @relation(fields: [organizationId], references: [id])
}

model OrgEntities {
  id             String         @id
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  organizationId String
  code           String?
  name           String
  aliases        String[]       @default([])
  Organization   Organization   @relation(fields: [organizationId], references: [id])
  OrgEntityMap   OrgEntityMap[]
}

model OrgEntityMap {
  id                 String             @id
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  organizationId     String
  orgEntityId        String
  isHistorical       Boolean            @default(false)
  entityId           String?
  historicalEntityId String?
  year               Int
  Entity             Entity?            @relation(fields: [entityId], references: [id])
  historical_entity  historical_entity? @relation(fields: [historicalEntityId], references: [id])
  OrgEntities        OrgEntities        @relation(fields: [orgEntityId], references: [id])
  Organization       Organization       @relation(fields: [organizationId], references: [id])
}

model OrgProgramMap {
  id                    String                 @id
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  organizationId        String
  orgProgramId          String
  isHistorical          Boolean                @default(false)
  programId             String?
  historicalProgramId   String?
  year                  Int
  historical_single_row historical_single_row? @relation(fields: [historicalProgramId], references: [id])
  OrgPrograms           OrgPrograms            @relation(fields: [orgProgramId], references: [id])
  Organization          Organization           @relation(fields: [organizationId], references: [id])
  Program               Program?               @relation(fields: [programId], references: [id])
}

model OrgPrograms {
  id             String          @id
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  organizationId String
  code           String?
  name           String
  aliases        String[]        @default([])
  OrgProgramMap  OrgProgramMap[]
  Organization   Organization    @relation(fields: [organizationId], references: [id])
}

model OrgProperties {
  id               String             @id
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  organizationId   String
  code             String?
  name             String
  aliases          String[]           @default([])
  Organization     Organization       @relation(fields: [organizationId], references: [id])
  OrgPropertiesMap OrgPropertiesMap[]
}

model OrgPropertiesMap {
  id                   String               @id
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  organizationId       String
  orgPropertyId        String
  isHistorical         Boolean              @default(false)
  propertyId           String?
  historicalPropertyId String?
  year                 Int
  historical_property  historical_property? @relation(fields: [historicalPropertyId], references: [id])
  OrgProperties        OrgProperties        @relation(fields: [orgPropertyId], references: [id])
  Organization         Organization         @relation(fields: [organizationId], references: [id])
  Property             Property?            @relation(fields: [propertyId], references: [id])
}

model Organization {
  id                     String                  @id
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  name                   String
  govId                  String?
  region                 String?
  googleSheetId          String?
  googleSheetSensitiveId String?
  oid_type               String?
  AdminOrgAssignment     AdminOrgAssignment[]
  Beneficiaries          Beneficiaries[]
  BeneficiaryAgeName     BeneficiaryAgeName[]
  BeneficiaryUnique      BeneficiaryUnique[]
  CountryOfOperation     CountryOfOperation[]
  DataRequest            DataRequest[]
  Donor                  Donor[]
  Employee               Employee[]
  Entity                 Entity[]
  EntityCountry          EntityCountry[]
  FutureEstimate         FutureEstimate[]
  FutureEstimateComment  FutureEstimateComment[]
  FutureEstimatePay      FutureEstimatePay[]
  FutureEstimateProgram  FutureEstimateProgram[]
  ImportIssue            ImportIssue[]
  ImportProgress         ImportProgress[]
  OrgCountries           OrgCountries[]
  OrgCountryMap          OrgCountryMap[]
  OrgEmployeeMap         OrgEmployeeMap[]
  OrgEmployees           OrgEmployees[]
  OrgEntities            OrgEntities[]
  OrgEntityMap           OrgEntityMap[]
  OrgProgramMap          OrgProgramMap[]
  OrgPrograms            OrgPrograms[]
  OrgProperties          OrgProperties[]
  OrgPropertiesMap       OrgPropertiesMap[]
  Partner                Partner[]
  Program                Program[]
  ProgramAreaMatrix      ProgramAreaMatrix[]
  ProgramByEntity        ProgramByEntity[]
  ProgramPopulation      ProgramPopulation[]
  Property               Property[]
  PropertyAllocation     PropertyAllocation[]
  Reconcilliation        Reconcilliation[]
  User                   User[]
  Volunteer              Volunteer[]
  Vulnerabilities        Vulnerabilities[]
  VulnerabilityFactor    VulnerabilityFactor[]
}

model Partner {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  dataRequestId  String
  Name           String
  Country        String?
  Relationship   String?
  DataRequest    DataRequest  @relation(fields: [dataRequestId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model Program {
  id                    String                  @id
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  dataRequestId         String
  organizationId        String
  ProgName              String?
  StartYr               Int?
  NextStep              String?
  Languages             String?
  MinProgDur            String?
  MaxProgDur            String?
  Photos                String?
  ProgCDU               Int?
  CDUsource             String?
  CDUdesc               String?
  ProgDirEmp            Int?
  ProgDirVol            Int?
  ProgDirSpend          Decimal?
  ProgExpResPerm        Decimal?
  SpendCat              String?
  ProgRev               Decimal?
  ExProgRev             String?
  ProgRevBen            Decimal?
  RevBenDesc            String?
  ExInKindBen           String?
  PartnerSupport        String?
  ProgShortDesc         String?
  ProgChallanges        String?
  ProgOutcomes          String?
  PID                   String?
  ProgAdmissOthProg     String?
  ProgAims              String?
  ProgCGNotes           String?
  ProgExpAllocations    Decimal?
  ProgExpResTemp        Decimal?
  ProgFocal             String?
  ProgGroupSize         Int?
  ProgIndAdmissDesc     String?
  ProgIndAdmissYN       String?
  ProgInteract          String?
  ProgLTApply           String?
  ProgMandE             String?
  ProgMinor             String?
  ProgPopApply          String?
  ProgRubric            Int?
  ProgSTapply           String?
  ProgTargetPopCat      String?
  ProgTheory            String?
  ProgVulApply          String?
  TargetPopDesc         String?
  Beneficiaries         Beneficiaries[]
  FutureEstimateProgram FutureEstimateProgram[]
  OrgProgramMap         OrgProgramMap[]
  DataRequest           DataRequest             @relation(fields: [dataRequestId], references: [id])
  Organization          Organization            @relation(fields: [organizationId], references: [id])
  ProgramAreaMatrix     ProgramAreaMatrix[]
  ProgramByEntity       ProgramByEntity[]
  ProgramPopulation     ProgramPopulation[]
  PropertyAllocation    PropertyAllocation[]
}

model ProgramArea {
  id                   String              @id
  createdAt            DateTime            @default(now())
  updatedAt            DateTime
  section              String
  category             String
  emphasis             String
  code                 String
  year                 Int                 @default(2024)
  latestEquivalentCode String?
  genSection           String?
  ProgramAreaMatrix    ProgramAreaMatrix[]

  @@unique([code, year])
}

model ProgramAreaMatrix {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  programId      String
  programAreaId  String
  Value          Decimal?
  Organization   Organization @relation(fields: [organizationId], references: [id])
  ProgramArea    ProgramArea  @relation(fields: [programAreaId], references: [id])
  Program        Program      @relation(fields: [programId], references: [id])
}

model ProgramByEntity {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  programId      String
  entityId       String
  Name           String
  Pct            Decimal?
  Entity         Entity       @relation(fields: [entityId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
  Program        Program      @relation(fields: [programId], references: [id])
}

model ProgramPopulation {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  programId      String
  Year           Int
  Metric         String
  NumericValue   Decimal?
  TextValue      String?
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id])
  Program        Program      @relation(fields: [programId], references: [id])
}

model Property {
  id                 String               @id
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  organizationId     String
  entityCountryId    String
  LocationName       String?
  Longitude          Decimal?
  Latitude           Decimal?
  Address            String?
  LocationSize       Decimal?
  LocationUnits      String?
  Title              String?
  LocationCity       String?
  LocationCountry    String?
  LocationOthEx      String?
  LocationType       String?
  OrgPropertiesMap   OrgPropertiesMap[]
  EntityCountry      EntityCountry        @relation(fields: [entityCountryId], references: [id])
  Organization       Organization         @relation(fields: [organizationId], references: [id])
  PropertyAllocation PropertyAllocation[]
}

model PropertyAllocation {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  propertyId     String
  programId      String?
  IsAdmin        Boolean      @default(false)
  Pct            Decimal?
  IsOther        Boolean      @default(false)
  organizationId String
